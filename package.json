{
  "name": "wyrdfold",
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many --target=test --all",
    "test:coverage": "nx run-many --target=test --all --coverage",
    "test:e2e": "nx run-many --target=e2e --all",
    "test:python": "nx run-many --target=lint,typecheck,test --projects=wyrdfold-api",
    "typecheck": "nx run-many --target=typecheck --all",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "analyze": "nx run wyrdfold:analyze",
    "lhci": "lhci autorun",
    "pom": "pnpm typecheck && pnpm lint:fix && pnpm format && pnpm test && pnpm test:python && pnpm test:coverage && pnpm test:e2e",
    "pom:affected": "nx affected -t typecheck && nx affected -t lint --fix && pnpm format && nx affected -t test --coverage && nx affected -t e2e",
    "affected": "nx affected -t lint test build typecheck e2e",
    "dev": "nx run-many --target=dev --all",
    "postinstall": "command -v uv >/dev/null && uv sync || echo 'uv not found — skipping Python deps (install: https://docs.astral.sh/uv/)'",
    "prepare": "husky",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:gen-types": "supabase gen types typescript --linked > apps/wyrdfold/src/lib/supabase/types.ts"
  },
  "private": true,
  "browserslist": [
    "last 2 versions",
    ">= 5% in US",
    "not dead",
    "not op_mini all",
    "not kaios > 0"
  ],
  "dependencies": {
    "@sentry/nextjs": "10.69.0",
    "@supabase/supabase-js": "2.112.2",
    "caniuse-lite": "1.0.30001807",
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@nx/devkit": "23.1.1",
    "@nx/docker": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@playwright/test": "1.62.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.47",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "~0.2.38",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "babel-jest": "^30.0.2",
    "eslint": "10.8.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "jest": "30.4.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "30.4.1",
    "jest-util": "^30.0.2",
    "jsdom": "^30.0.1",
    "knip": "^6.32.0",
    "lint-staged": "17.3.0",
    "nx": "23.1.1",
    "playwright": "1.62.1",
    "postcss": "8.5.26",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "supabase": "2.111.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tslib": "^2.3.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.66.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
